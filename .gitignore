# dotenv environment variable files
# `.env.production` holds every production secret (9 JWT/signing keys, the
# database and Redis passwords, the SendGrid key) and is read at container start
# by docker-compose. It must never be committed — only the
# `production.env.example` template belongs in git.
.env
.env.*
!.env.example
!.env.*.example
.env.local

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
