PORT=3000
NODE_ENV=dev

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=nucleus
POSTGRES_PASSWORD=nucleus_dev_pw
POSTGRES_DB=nucleus

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_pw

# Admin auth (JWT)
JWT_ADMIN_ACCESS_SECRET=bd4c17a527f0c045e08c9bff702165dacc3d755ab988f4272ce4c83688f584b04ea8be0ffac5a1853cb71fe9b806baa7
JWT_ADMIN_REFRESH_SECRET=9b607b45fa6577eedccd4177073985063109d30e4f6596e68c332bb6bd008ac067553d68f2f78693388d726f2cb6c0da
JWT_ADMIN_ACCESS_TTL=15m
JWT_ADMIN_REFRESH_TTL=10h

# Student auth (JWT). Must be different from the admin secrets above.
# Generate fresh secrets per environment: `openssl rand -hex 48`
JWT_STUDENT_ACCESS_SECRET=
JWT_STUDENT_REFRESH_SECRET=
JWT_STUDENT_ACCESS_TTL=15m
JWT_STUDENT_REFRESH_TTL=7d
STUDENT_PASSWORD_RESET_TTL=30m
STUDENT_APP_URL=http://localhost:5000

# Employee auth (JWT). Must be different from the admin AND student secrets above.
# Generate fresh secrets per environment: `openssl rand -hex 48`
JWT_EMPLOYEE_ACCESS_SECRET=
JWT_EMPLOYEE_REFRESH_SECRET=
JWT_EMPLOYEE_ACCESS_TTL=15m
JWT_EMPLOYEE_REFRESH_TTL=30d
EMPLOYEE_PASSWORD_RESET_TTL=30m
# Base URL of the employee-facing portal (nucleus-ui on the employee.* subdomain).
# In dev nucleus-ui shares :5000 with the student app, so the `?app=employee`
# marker is required so the reset link lands on the employee portal. In
# production set this to the employee subdomain with no query string.
EMPLOYEE_APP_URL=http://localhost:5000?app=employee

# Mail (SendGrid). Leave SENDGRID_API_KEY blank in dev — emails are then logged
# to the console / stored in the dev_mail_outbox table instead of being sent.
# MAIL_FROM is required only when a key is set (it must be a verified sender).
SENDGRID_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Nucleus

# Google OIDC for admin sign-in. The client ID must match the Web application
# credential configured for the admin UI in Google Cloud Console. Allowed
# domains is a comma-separated allowlist; an empty value disables the domain
# check (not recommended). Auto-provisioning is OFF — only existing admins
# can sign in with Google.
GOOGLE_ADMIN_OIDC_CLIENT_ID=
GOOGLE_ADMIN_ALLOWED_DOMAINS=

# Google OIDC for employee sign-in. Comma-separated to support web + Android +
# iOS client ids from one OAuth project. Falls back to GOOGLE_ADMIN_OIDC_CLIENT_ID
# when unset. Auto-provisioning is OFF — only existing employee records (matched
# by email) can sign in with Google.
GOOGLE_EMPLOYEE_OIDC_CLIENT_ID=

# Set to "true" to allow POST /admin/migrations/run from the admin UI.
# GET /admin/migrations (status) is always available to authenticated admins.
ALLOW_ADMIN_MIGRATIONS=false
