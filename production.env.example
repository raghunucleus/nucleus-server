# Production environment for the docker-compose deployment stack.
#
#   cp production.env.example .env.production
#
# Fill in every value marked REQUIRED. With NODE_ENV=production the server
# VALIDATES this file at boot (src/config/env.validation.ts) and refuses to
# start if a required value is missing, a secret is shorter than 32 chars, two
# secrets are identical, or a known dev default (nucleus_dev_pw / redis_dev_pw /
# minioadmin) is still present. It reports ALL problems at once, so read the
# whole list before editing.
#
# Generate every secret INDEPENDENTLY — the validator rejects duplicates:
#   openssl rand -base64 48
#
# NOTE: PostgreSQL, Redis and object storage are EXTERNAL. The compose stack
# runs only the app and the one-shot migrate. The database and the S3 bucket
# must exist before first boot; nothing here creates them.

# ── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# Exact browser origins of the deployed portals, comma separated, scheme+host
# (+port) with NO path and no trailing slash. "*" is rejected. REQUIRED.
# All four are needed: nucleus-ui serves three of them from one bundle and
# nucleus-admin-ui is a separate deployment.
CORS_ORIGINS=https://nucleusadmin.raghuenggcollege.in,https://employee.raghuenggcollege.in,https://parent.raghuenggcollege.in,https://student.raghuenggcollege.in

# Base URLs of the deployed portals. Password-reset and temp-password emails
# build their links from these, so a wrong value sends users to a dead page.
# REQUIRED, must be absolute http(s).
# NOTE: unlike sample.env, EMPLOYEE_APP_URL carries NO `?app=employee` query —
# that marker only exists because dev shares one origin across all three
# audiences. On a real subdomain the hostname already selects the portal.
STUDENT_APP_URL=https://student.raghuenggcollege.in
EMPLOYEE_APP_URL=https://employee.raghuenggcollege.in

# Hop count of reverse proxies in front of the app, so the real client IP is
# read from X-Forwarded-For and appears in the logs. `1` for a single nginx.
# REMOVE this if the app port is ever hit directly — trusting XFF with no proxy
# in front lets any client forge its own address.
TRUST_PROXY=1

# /docs (Swagger) publishes the entire API surface. OFF in production unless
# this is exactly `true`.
ENABLE_SWAGGER_IN_PRODUCTION=

# pino level. Defaults to `info` in production; set `debug` only to chase a bug.
LOG_LEVEL=info

# POST /admin/migrations/run from the admin UI. Leave OFF — the compose stack
# already applies migrations in the one-shot `migrate` service, and an
# admin-triggered run racing a deploy is how schemas get half-applied.
ALLOW_ADMIN_MIGRATIONS=false

# ── PostgreSQL (external — RDS) ─────────────────────────────────────────────
# The server, the database and this role must exist before first boot.
# POSTGRES_HOST is REQUIRED — unset means "localhost", which inside the app
# container is nothing at all.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=nucleus

# TLS to the database. RDS Postgres 16+ ships rds.force_ssl=1 in its default
# parameter group, so this MUST be `true` there or every connection — including
# the migrate step — is refused outright.
POSTGRES_SSL=true
# Verify the server certificate against a CA bundle (strongly recommended —
# without it the connection is encrypted but unverified, and the app logs a
# warning at boot). Download the RDS bundle from
# https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem and mount it
# into the container (uncomment the volume in docker-compose.yml, both services).
# POSTGRES_SSL_CA_FILE=/etc/ssl/rds/global-bundle.pem

# ── Redis (external — ElastiCache) ──────────────────────────────────────────
# REQUIRED. Redis carries the Socket.IO fan-out for student chat and both
# notification streams, plus the presigned-URL cache.
REDIS_HOST=
REDIS_PORT=6379
# The AUTH token. May be left empty ONLY when REDIS_TLS=true (an instance with
# no auth token, isolated by security group); empty and unencrypted is a fatal
# boot error.
REDIS_PASSWORD=
# `true` for ElastiCache with encryption-in-transit enabled.
REDIS_TLS=true

# ── Auth: JWT secrets ───────────────────────────────────────────────────────
# Four separate audiences — admin, student, guardian, employee — each with its
# own login screen, guards and token storage. That separation is only real if
# the signing keys differ: all eight (plus SECURITY_PASS_SECRET below) must be
# present, >=32 chars, and MUTUALLY DISTINCT. Sharing one means a student token
# verifies as an admin token.
JWT_ADMIN_ACCESS_SECRET=
JWT_ADMIN_REFRESH_SECRET=
JWT_ADMIN_ACCESS_TTL=15m
JWT_ADMIN_REFRESH_TTL=10h

JWT_STUDENT_ACCESS_SECRET=
JWT_STUDENT_REFRESH_SECRET=
JWT_STUDENT_ACCESS_TTL=15m
JWT_STUDENT_REFRESH_TTL=7d

JWT_GUARDIAN_ACCESS_SECRET=
JWT_GUARDIAN_REFRESH_SECRET=
JWT_GUARDIAN_ACCESS_TTL=15m
JWT_GUARDIAN_REFRESH_TTL=7d

JWT_EMPLOYEE_ACCESS_SECRET=
JWT_EMPLOYEE_REFRESH_SECRET=
JWT_EMPLOYEE_ACCESS_TTL=15m
JWT_EMPLOYEE_REFRESH_TTL=30d

# Password-reset and OTP lifetimes.
STUDENT_PASSWORD_RESET_TTL=30m
EMPLOYEE_PASSWORD_RESET_TTL=30m
GUARDIAN_OTP_TTL=10m

# Account invitations. The invite TTL is deliberately much longer than the reset
# TTL — an invite is a first-contact email that may sit unread over a weekend,
# and a whole-cohort batch cannot be cheaply re-sent. The cooldown makes a
# double-clicked "send batch" harmless; the cap bounds one request's fan-out.
STUDENT_ACCOUNT_INVITE_TTL=7d
EMPLOYEE_ACCOUNT_INVITE_TTL=7d
ACCOUNT_INVITE_RESEND_COOLDOWN=5m
ACCOUNT_INVITE_MAX_BATCH=500

# ── Security-pass QR signing ────────────────────────────────────────────────
# ID cards render a signed QR that a gate scanner verifies. REQUIRED and held to
# the same rules as the JWT secrets — it is read via getOrThrow at FIRST USE, so
# without boot validation a missing value starts fine and only fails when
# somebody is standing at the gate.
SECURITY_PASS_SECRET=
SECURITY_PASS_TTL=60s

# ── Mail (SendGrid) ─────────────────────────────────────────────────────────
# REQUIRED. Without a key, MailService LOGS every message and drops it — the app
# boots green while no student can reset a password and no guardian receives an
# OTP. MAIL_FROM must be a sender verified in SendGrid.
SENDGRID_API_KEY=
MAIL_FROM=
MAIL_FROM_NAME=Nucleus

# ── Google OIDC ─────────────────────────────────────────────────────────────
# Each portal's production origin must also be listed as an authorized
# JavaScript origin on the corresponding OAuth client in Google Cloud Console.
# Auto-provisioning is OFF everywhere — only existing records can sign in.
# GOOGLE_ADMIN_ALLOWED_DOMAINS is a comma-separated allowlist shared by admin,
# employee and student Google sign-in; empty disables the domain check (not
# recommended).
GOOGLE_ADMIN_OIDC_CLIENT_ID=
GOOGLE_ADMIN_ALLOWED_DOMAINS=raghuenggcollege.in
# Both fall back to GOOGLE_ADMIN_OIDC_CLIENT_ID when unset.
GOOGLE_EMPLOYEE_OIDC_CLIENT_ID=
GOOGLE_STUDENT_OIDC_CLIENT_ID=

# ── Object storage (AWS S3) ─────────────────────────────────────────────────
# ONE private bucket holds everything, separated by key prefix:
#   student-photos/  student-certificates/  companies/  drives/  exports/
# It must exist before first boot — the app never creates it. S3 bucket names
# are globally unique across ALL AWS accounts, so this account must own the name.
# Every read is a short-lived presigned GET; the API never proxies object bytes.
#
# Credentials — two modes:
#   - PREFERRED on EC2: leave BOTH keys empty. The SDK's default provider chain
#     picks up the instance IAM role from metadata, so there is no long-lived
#     key on the box. The boot log says which mode is active.
#   - Static keys: set BOTH to an IAM user's key pair. Setting exactly one is a
#     boot failure.
# S3_ENDPOINT stays EMPTY for real AWS (the SDK derives it from S3_REGION); it
# exists only for MinIO in dev. S3_FORCE_PATH_STYLE must be false on AWS —
# virtual-hosted style is what makes the bucket its own origin, which is what the
# portals' Content-Security-Policy allowlists.
S3_BUCKET=raghu-nucleus
S3_REGION=ap-south-1
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACCESS_KEY=
S3_SECRET_KEY=

# How long a finished async export stays downloadable before the hourly cleanup
# cron deletes it from the bucket. Unset = 24.
EXPORT_TTL_HOURS=24

# ── Retention ───────────────────────────────────────────────────────────────
# Days before the nightly sweep deletes student chat messages. The student app
# shows this number. 0 = purge all.
CHAT_MESSAGE_RETENTION_DAYS=90

# ── Push notifications (Expo) ───────────────────────────────────────────────
# Optional. Plain sends work without it; set it if you enable Expo's enhanced
# security for push, which requires an access token.
EXPO_ACCESS_TOKEN=
